{
	"name": "alt-text-tracker",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"worker": "npx wrangler dev --env local --test-scheduled",
		"emulate": "vite build -w & npx wrangler pages dev .svelte-kit/cloudflare --live-reload --local --binding PRODUCTION=false --d1 DB=DB",
		"init": "./bin/init",
		"update": "./bin/update",
		"clear": "./bin/clear",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260511.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3": "^7.4.3",
		"@types/eslint": "^9.6.1",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"wrangler": "^4.90.1"
	},
	"type": "module",
	"dependencies": {
		"@michigandaily/wputils": "github:michigandaily/wputils",
		"d3": "^7.9.0"
	}
}
